FROM golang:1.26.3-bookworm@sha256:386d475a660466863d9f8c766fec64d7fdad3edac2c6a05020c09534d71edb4b
WORKDIR /src
ENV GOTOOLCHAIN=local CGO_ENABLED=0
COPY source/go.mod source/go.sum ./
RUN go mod download && go mod verify
COPY norma-tool-history.patch /tmp/norma-tool-history.patch
COPY norma-indexed-tool-execution.patch /tmp/norma-indexed-tool-execution.patch
COPY norma-provider-vsock-terminal.patch /tmp/norma-provider-vsock-terminal.patch
RUN cp -a /go/pkg/mod/github.com/\!autumn-27/norma@v0.4.3 /managed-norma && chmod -R u+w /managed-norma \
    && cd /managed-norma && git apply --check /tmp/norma-tool-history.patch && git apply /tmp/norma-tool-history.patch \
    && git apply --check /tmp/norma-indexed-tool-execution.patch && git apply /tmp/norma-indexed-tool-execution.patch \
    && git apply --check /tmp/norma-provider-vsock-terminal.patch && git apply /tmp/norma-provider-vsock-terminal.patch
COPY source/ ./
RUN go mod edit -replace=github.com/Autumn-27/norma=/managed-norma
COPY agent-extension/ ./agent/
COPY server-extension/ ./server/
COPY traffic-extension/ ./traffic/
COPY managed.patch /tmp/managed.patch
RUN git apply --check /tmp/managed.patch && git apply /tmp/managed.patch
COPY origin-extension/agent/ ./agent/
COPY origin-extension/db/ ./db/
COPY origin-extension/server/ ./server/
COPY origin-extension/cloudegress/ ./cloudegress/
COPY provider-origin-redirect.patch /tmp/provider-origin-redirect.patch
RUN --network=none git apply --check /tmp/provider-origin-redirect.patch && git apply /tmp/provider-origin-redirect.patch
COPY provider-credential-target.patch /tmp/provider-credential-target.patch
RUN --network=none git apply --check /tmp/provider-credential-target.patch && git apply /tmp/provider-credential-target.patch
COPY provider-vsock-transport.patch /tmp/provider-vsock-transport.patch
RUN --network=none git apply --check /tmp/provider-vsock-transport.patch && git apply /tmp/provider-vsock-transport.patch
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN --network=none GOMAXPROCS=2 go test -p 2 -mod=readonly github.com/Autumn-27/norma/llm github.com/Autumn-27/norma/harness -count=1 -json -coverprofile=/tmp/norma.cover | tee /tmp/norma-tests.json
RUN --network=none GOMAXPROCS=2 go test -p 2 -mod=readonly ./traffic ./agent ./server ./cloudegress -count=1 -json | tee /tmp/cloud-provider-tests.json
RUN --network=none GOMAXPROCS=2 go build -p 2 -mod=readonly -trimpath -buildvcs=false -ldflags="-s -w -X main.version=artex-mac-e75ae371-cloud7" -o /out/artex ./cmd/artex

+func TestManagedIndexedSchedulerKeepsCancelledQueueIdle(t *testing.T) {
+	ctx, cancel := context.WithCancel(t.Context())
+	defer cancel()
+	var calls atomic.Int32
+	l := &loop{ctx: ctx, toolCtx: ctx, sem: make(chan struct{}, 1), in: QueryInput{Tools: tool.NewRegistry(managedIndexedTool(&calls)), PermissionMode: permission.ModeBypass, WorkingDir: t.TempDir()}}
+	exec := newStreamExec(l)
+	exec.queue([]llm.ContentBlock{{Type: llm.BlockToolUse, ID: "queued", Name: "IndexedFixture", Input: json.RawMessage(`{"value":1}`)}})
+	cancel()
+	exec.processQueue()
+	exec.mu.Lock()
+	status := exec.tools[0].status
+	exec.mu.Unlock()
+	if status != stQueued {
+		t.Fatalf("cancelled tool left queue: status=%d", status)
+	}
+}
+
+func TestManagedIndexedSemaphoreWaitRetainsOriginalCancellation(t *testing.T) {
+	ctx, cancel := context.WithCancel(t.Context())
+	defer cancel()
+	var calls atomic.Int32
+	l := &loop{ctx: t.Context(), toolCtx: ctx, sem: make(chan struct{}, 1), in: QueryInput{Tools: tool.NewRegistry(managedIndexedTool(&calls)), PermissionMode: permission.ModeBypass, WorkingDir: t.TempDir()}}
+	exec := newStreamExec(l)
+	track := &tracked{block: llm.ContentBlock{Type: llm.BlockToolUse, ID: "waiting", Name: "IndexedFixture", Input: json.RawMessage(`{"value":1}`)}, status: stExecuting}
+	l.sem <- struct{}{}
+	done := make(chan struct{})
+	go func() { exec.run(track); close(done) }()
+	cancel()
+	l.toolCtx = t.Context() // The next settlement turn receives a live context.
+	<-l.sem
+	select {
+	case <-done:
+	case <-time.After(2 * time.Second):
+		t.Fatal("cancelled tool did not settle")
+	}
+	if calls.Load() != 0 || !track.result.IsError {
+		t.Fatal("old queued tool ran in the next turn context")
+	}
+}

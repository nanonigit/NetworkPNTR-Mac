+func TestManagedIndexedToolExecutionRejectsIncompleteAndCancelledStreams(t *testing.T) {
+	for _, mode := range []string{"missing finish reason", "missing terminal event", "length stop", "transport error", "cancel"} {
+		t.Run(mode, func(t *testing.T) {
+			index := 0
+			ctx, cancel := context.WithCancel(t.Context())
+			defer cancel()
+			var calls atomic.Int32
+			input := QueryInput{Messages: []llm.Message{llm.UserText("fixture")}, Tools: tool.NewRegistry(managedIndexedTool(&calls)), PermissionMode: permission.ModeBypass, WorkingDir: t.TempDir()}
+			requests := 0
+			model := func(context.Context, llm.CompletionRequest) iter.Seq2[llm.StreamEvent, error] {
+				requests++
+				return func(yield func(llm.StreamEvent, error) bool) {
+					if requests != 1 {
+						for _, event := range textTurn("unexpected second request") {
+							if !yield(event, nil) {
+								return
+							}
+						}
+						return
+					}
+					events := []llm.StreamEvent{
+						{Type: llm.SEToolUseStart, ToolID: "call", ToolName: "IndexedFixture", ToolIndex: &index},
+						{Type: llm.SEToolInputJSON, Text: `{"value":1}`, ToolIndex: &index},
+						{Type: llm.SETextDelta, Text: "progress"},
+					}
+					for _, event := range events {
+						if !yield(event, nil) {
+							return
+						}
+					}
+					if mode == "transport error" {
+						yield(llm.StreamEvent{}, errors.New("synthetic stream interruption"))
+						return
+					}
+					reason := "tool_use"
+					if mode == "missing finish reason" {
+						reason = ""
+					}
+					if mode == "length stop" {
+						reason = "max_tokens"
+					}
+					if !yield(llm.StreamEvent{Type: llm.SEMessageDelta, StopReason: reason}, nil) {
+						return
+					}
+					if mode != "missing terminal event" {
+						yield(llm.StreamEvent{Type: llm.SEMessageStop}, nil)
+					}
+				}
+			}
+			var terminal *Terminal
+			for event, err := range Query(ctx, input, QueryDeps{CallModel: model}) {
+				if err != nil {
+					t.Fatal(err)
+				}
+				if mode == "cancel" && event.Kind == KindText {
+					cancel()
+				}
+				if event.Kind == KindToolUse {
+					t.Error("interrupted tool was dispatched")
+				}
+				if event.Kind == KindResult {
+					terminal = event.Terminal
+				}
+			}
+			expected := ReasonModelError
+			if mode == "cancel" {
+				expected = ReasonAbortedStreaming
+			}
+			if requests != 1 || calls.Load() != 0 || terminal == nil || terminal.Reason != expected || terminal.Err == nil || strings.Contains(terminal.Text, "unexpected") {
+				t.Fatalf("unexpected terminal state: requests=%d, calls=%d", requests, calls.Load())
+			}
+		})
+	}
+}

 func newSSEScanner(body io.Reader) *sseScanner {
 	return &sseScanner{r: bufio.NewReaderSize(body, 64*1024)}
+}
+
+// requireTransportEnd checks the broker terminal after a provider-level end or error.
+func (s *sseScanner) requireTransportEnd(body io.Reader) error {
+	terminal, ok := body.(interface{ RequiresTransportEnd() bool })
+	if !ok || !terminal.RequiresTransportEnd() {
+		return nil
+	}
+	_, err := io.Copy(io.Discard, s.r)
+	return err
 }
 

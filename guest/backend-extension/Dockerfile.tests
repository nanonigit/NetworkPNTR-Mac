FROM golang:1.26.3-bookworm@sha256:386d475a660466863d9f8c766fec64d7fdad3edac2c6a05020c09534d71edb4b
WORKDIR /src
ENV GOTOOLCHAIN=local CGO_ENABLED=0
COPY source/go.mod source/go.sum ./
RUN go mod download && go mod verify
COPY source/ ./
COPY extension/ ./traffic/
COPY server-extension/ ./server/
COPY managed.patch /tmp/managed.patch
RUN git apply --check /tmp/managed.patch && git apply /tmp/managed.patch
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN --network=none GOMAXPROCS=2 go test -p 2 -mod=readonly ./traffic ./server -count=1 -json -coverprofile=/tmp/managed.cover | tee /tmp/managed-tests.json && go tool cover -func=/tmp/managed.cover
RUN --network=none GOMAXPROCS=2 go build -p 2 -mod=readonly -trimpath -buildvcs=false -ldflags="-s -w -X main.version=artex-mac-e75ae371-blob1" -o /out/artex ./cmd/artex

diff --git a/db/schema.sql b/db/schema.sql
index a945b76..abad3c6 100644
--- a/db/schema.sql
+++ b/db/schema.sql
@@ -1027,6 +1027,20 @@ CREATE TABLE IF NOT EXISTS scheduler_state (
     value TEXT NOT NULL DEFAULT ''
 );
 
+CREATE TABLE IF NOT EXISTS scheduler_consumed_task_timeouts (
+    task_id BIGINT PRIMARY KEY
+);
+
+-- Seed existing timeouts exactly once while applying the schema.
+WITH migration AS (
+    INSERT INTO scheduler_state(key, value) VALUES ('task_timeout_membership_v1', '1')
+    ON CONFLICT DO NOTHING
+    RETURNING key
+)
+INSERT INTO scheduler_consumed_task_timeouts(task_id)
+SELECT tasks.id FROM tasks CROSS JOIN migration WHERE tasks.status = 'timeout'
+ON CONFLICT DO NOTHING;
+

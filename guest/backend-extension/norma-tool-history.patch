@@ -0,0 +1,72 @@
+package llm
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+)
+
+// Only the documented tool signature is retained; arbitrary vendor fields are not replayed.
+type oaGoogleContent struct {
+	ThoughtSignature string `json:"thought_signature,omitempty"`
+}
+type oaExtraContent struct {
+	Google oaGoogleContent `json:"google"`
+}
+
+func (call oaToolCall) thoughtSignature() string {
+	if call.ExtraContent == nil {
+		return ""
+	}
+	return call.ExtraContent.Google.ThoughtSignature
+}
+
+func (a *Accumulator) toolPosition(ev StreamEvent) (int, bool) {
+	if ev.ToolIndex != nil {
+		position, ok := a.indexedTools[*ev.ToolIndex]
+		return position, ok
+	}
+	position := len(a.toolInputs) - 1
+	return position, position >= 0
+}
+
+// Copy recursively so changing wire adapters never mutates persisted history.
+func stripOpenAIThoughtSignatures(messages []Message) []Message {
+	out := append([]Message(nil), messages...)
+	for i := range out {
+		out[i].Content = stripOpenAIBlockSignatures(out[i].Content)
+	}
+	return out
+}
+func stripOpenAIBlockSignatures(blocks []ContentBlock) []ContentBlock {
+	out := append([]ContentBlock(nil), blocks...)
+	for i := range out {
+		out[i].OpenAIThoughtSignature = ""
+		out[i].OpenAIThoughtSignatureScope = ""
+		if out[i].Content != nil {
+			out[i].Content = stripOpenAIBlockSignatures(out[i].Content)
+		}
+	}
+	return out
+}
+
+// Scope is a context identifier, not an authorization token; it contains no key.
+func (c Config) signatureScope() string {
+	encoded, _ := json.Marshal([]string{"artex-openai-tool-v1", c.BaseURL, c.Model})
+	sum := sha256.Sum256(encoded)
+	return hex.EncodeToString(sum[:])
+}
+func scopedOpenAIThoughtSignatures(messages []Message, scope string) []Message {
+	out := append([]Message(nil), messages...)
+	for i := range out {
+		out[i].Content = append([]ContentBlock(nil), out[i].Content...)
+		for j := range out[i].Content {
+			block := &out[i].Content[j]
+			if block.OpenAIThoughtSignatureScope != scope {
+				block.OpenAIThoughtSignature = ""
+				block.OpenAIThoughtSignatureScope = ""
+			}
+		}
+	}
+	return out
+}

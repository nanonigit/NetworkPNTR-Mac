+package llm
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+)
+
+func TestManagedToolIndexAndEarlySignature(t *testing.T) {
+	a := NewAccumulator()
+	zero, one := 0, 1
+	a.Add(StreamEvent{Type: SEToolUseSignature, ToolIndex: &one, Text: "opaque-second"})
+	a.Add(StreamEvent{Type: SEToolUseStart, ToolIndex: &zero, ToolID: "zero", ToolName: "fixture"})
+	a.Add(StreamEvent{Type: SEToolUseStart, ToolIndex: &one, ToolID: "one", ToolName: "fixture"})
+	a.Add(StreamEvent{Type: SEToolInputJSON, ToolIndex: &zero, Text: `{"first":`})
+	a.Add(StreamEvent{Type: SEToolInputJSON, ToolIndex: &one, Text: `{"second":2}`})
+	a.Add(StreamEvent{Type: SEToolInputJSON, ToolIndex: &zero, Text: `1}`})
+	a.Add(StreamEvent{Type: SEToolUseSignature, ToolIndex: &zero, Text: "opaque-first"})
+	calls := a.Message().ToolUses()
+	if len(calls) != 2 || string(calls[0].Input) != `{"first":1}` || string(calls[1].Input) != `{"second":2}` || calls[0].OpenAIThoughtSignature != "opaque-first" || calls[1].OpenAIThoughtSignature != "opaque-second" {
+		t.Fatal("indexed history changed")
+	}
+	// An event without a known tool must not change the most recent tool.
+	unknown := 99
+	a.Add(StreamEvent{Type: SEToolInputJSON, ToolIndex: &unknown, Text: "wrong"})
+	a.Add(StreamEvent{Type: SEToolUseSignature, ToolIndex: &unknown, Text: "wrong"})
+	if a.Message().ToolUses()[1].OpenAIThoughtSignature != "opaque-second" {
+		t.Fatal("foreign signature applied")
+	}
+}
+
+func TestManagedAnthropicDoesNotSendOpenAIMetadataOrMutateHistory(t *testing.T) {
+	messages := []Message{{Role: RoleAssistant, Content: []ContentBlock{
+		{Type: BlockThinking, Thinking: "thought", Signature: "anthropic-signature"},
+		{Type: BlockToolUse, ID: "call", Name: "fixture", Input: json.RawMessage(`{}`), OpenAIThoughtSignature: "opaque-openai"},
+	}}, {Role: RoleUser, Content: []ContentBlock{ToolResultText("call", "result", false)}}}
+	messages[1].Content[0].Content[0].OpenAIThoughtSignature = "nested-opaque"
+	before, _ := json.Marshal(messages)
+	provider := anthropicProvider{cfg: Config{Model: "fixture", ThinkingType: "enabled"}}
+	body, err := provider.buildBody(CompletionRequest{Messages: messages}, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, forbidden := range []string{"openai_thought_signature", "opaque-openai", "nested-opaque"} {
+		if strings.Contains(string(body), forbidden) {
+			t.Fatal("OpenAI metadata leaked to Anthropic")
+		}
+	}
+	if !strings.Contains(string(body), "anthropic-signature") {
+		t.Fatal("Anthropic signature lost")
+	}
+	after, _ := json.Marshal(messages)
+	if string(before) != string(after) {
+		t.Fatal("input history mutated")
+	}
+	if (oaToolCall{}).thoughtSignature() != "" {
+		t.Fatal("unsigned call acquired signature")
+	}
+}
+
+func TestManagedUnknownSignatureContextIsNotForwarded(t *testing.T) {
+	for _, base := range []string{"https://api.openai.com/v1", "https://api.groq.com/openai/v1", "https://custom.invalid/v1"} {
+		t.Run(base, func(t *testing.T) {
+			messages := []Message{{Role: RoleAssistant, Content: []ContentBlock{{Type: BlockToolUse, ID: "call", Name: "fixture", Input: json.RawMessage(`{}`), OpenAIThoughtSignature: "opaque-from-another-provider"}}}, {Role: RoleUser, Content: []ContentBlock{ToolResultText("call", "result", false)}}}
+			provider := openaiProvider{cfg: Config{Model: "fixture", BaseURL: base}}
+			body, err := provider.buildBody(CompletionRequest{Messages: messages}, false)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if strings.Contains(string(body), "opaque-from-another-provider") {
+				t.Error("unbound signature forwarded to another provider")
+			}
+		})
+	}
+}
+
+func TestManagedSignatureOriginAndModelIsolation(t *testing.T) {
+	source := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		_, _ = w.Write([]byte(`{"choices":[{"message":{"role":"assistant","tool_calls":[{"id":"call","type":"function","function":{"name":"fixture","arguments":"{}"},"extra_content":{"google":{"thought_signature":"opaque-bound"}}}]},"finish_reason":"tool_calls"}]}`))
+	}))
+	defer source.Close()
+	provider, err := NewProvider(Config{Format: FormatOpenAI, BaseURL: source.URL, Model: "source-model", APIKey: "synthetic", MaxRetries: -1, EmptyResponseRetries: -1})
+	if err != nil {
+		t.Fatal(err)
+	}
+	message, _, _, err := provider.Complete(context.Background(), CompletionRequest{Messages: []Message{UserText("fixture")}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	raw, _ := json.Marshal(message)
+	var restored Message
+	if err := json.Unmarshal(raw, &restored); err != nil {
+		t.Fatal(err)
+	}
+	messages := []Message{restored, {Role: RoleUser, Content: []ContentBlock{ToolResultText("call", "result", false)}}}
+	for _, cfg := range []Config{
+		{BaseURL: source.URL, Model: "source-model"},
+		{BaseURL: source.URL + "/different", Model: "source-model"},
+		{BaseURL: source.URL, Model: "other-model"},
+		{BaseURL: "https://api.openai.com/v1", Model: "source-model"},
+		{BaseURL: "https://api.groq.com/openai/v1", Model: "source-model"},
+		{BaseURL: "https://custom.invalid/v1", Model: "source-model"},
+	} {
+		body, err := (&openaiProvider{cfg: cfg}).buildBody(CompletionRequest{Messages: messages}, false)
+		if err != nil {
+			t.Fatal(err)
+		}
+		want := cfg.BaseURL == source.URL && cfg.Model == "source-model"
+		if strings.Contains(string(body), "opaque-bound") != want {
+			t.Error("signature crossed endpoint/model scope")
+		}
+		if strings.Contains(string(body), "openai_thought_signature_scope") {
+			t.Error("internal scope sent upstream")
+		}
+	}
+	after, _ := json.Marshal(messages[0])
+	if string(after) != string(raw) {
+		t.Error("encoding mutated signed history")
+	}
+}

    "llm.ui.globalRetry": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Global retry policy"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全体の再試行ポリシー"
          }
        }
      }
    },
    "llm.ui.retryHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies connection → empty response → stream → rotation circuit breaker → intent retry in order. The first three layers can be overridden per model configuration."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続 → 空応答 → ストリーム → ローテーションの遮断 → 意図の再実行の順に適用します。最初の3層はモデル設定ごとに上書きできます。"
          }
        }
      }
    },
    "llm.ui.globalConnectDetail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connection failures, timeouts, and HTTP 408, 429, or 500/502/503/504. Applies before receiving HTTP 200."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続失敗・タイムアウト・408・429・500/502/503/504。HTTP 200を受け取る前に適用します。"
          }
        }
      }
    },
    "llm.ui.globalEmptyDetail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI format only. Retries successfully completed responses with an empty body."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI形式のみ。正常終了しても本文が空の応答を再試行します。"
          }
        }
      }
    },
    "llm.ui.globalStreamDetail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnections or transient failures before any output is delivered. Does not duplicate content after output starts."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "出力をまだ届けていない時の切断や一時障害。出力開始後の内容を二重に流しません。"
          }
        }
      }
    },
    "llm.ui.breaker": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rotation circuit breaker"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローテーションの遮断"
          }
        }
      }
    },
    "llm.ui.breakerHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Consecutive transient failures temporarily exclude a provider. Permanent errors, such as invalid settings or insufficient balance, trip the breaker immediately."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "連続する一時障害で接続先を一時的に除外します。無効設定や残高不足等の恒久エラーは即座に遮断されます。"
          }
        }
      }
    },
    "llm.ui.intent": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Intent retry"

      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Higher values have priority. The active configuration always comes first; equal priorities take turns."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大きい値から優先します。有効な設定は常に先頭、同順位は交代して使います。"
          }
        }
      }
    },

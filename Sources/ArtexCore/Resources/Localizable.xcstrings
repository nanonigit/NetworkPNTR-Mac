    "llm.ui.proxyHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The proxy applies to outbound LLM traffic. HTTP, HTTPS, and SOCKS5 are supported; leave blank for a direct connection. Outbound networking in the dedicated VM is still awaiting verification."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロキシはLLMの外向き通信に適用します。HTTP/HTTPS/SOCKS5を指定でき、空欄は直接接続です。現在の専用VMは外向き通信の検証待ちです。"
          }
        }
      }
    },
    "llm.ui.sessionHeader": {

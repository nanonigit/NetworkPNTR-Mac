    "dashboard.ui.sourceHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Legacy totals estimate usage from task and conversation activity. The usage ledger records each call, including interrupted work. It excludes consumption before the ledger was introduced."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "旧集計はタスク・会話の活動履歴に基づく概算です。使用量台帳は呼び出し単位で記録し、中断した処理の使用量も含みます。台帳導入前の消費は含みません。"
          }
        }
      }
    },

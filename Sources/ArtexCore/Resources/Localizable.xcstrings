    "shell.plannedFeature": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Planned for phase %lld. We will compare functionality and UI/UX with browser route %@. This feature is not available yet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フェーズ%lldで移植予定です。ブラウザ版の %@ と機能・UI/UXを比較して実装します。現在は操作できません。"
          }
        }
      }
    },

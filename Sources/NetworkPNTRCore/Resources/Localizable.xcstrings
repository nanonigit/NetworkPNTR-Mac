    "agent.seed.worker.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Picks up a single intent and executes it, writing discovered facts / vulnerabilities back to the knowledge graph before stopping."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インテントを 1 つ受け取って実行し、発見した事実・脆弱性をナレッジグラフに記録して停止します。"
          }
        }
      }
    },
    "agent.seed.auto.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto"
          }
        }
      }
    },
    "agent.seed.auto.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Platform operations assistant: uses tools to manage tasks (create / view / pause / hint) and assets, and can create or modify skills, custom tools, and MCP."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プラットフォーム運用アシスタント: ツールで案件(作成・参照・一時停止・ヒント付与)と資産を管理し、skill・カスタムツール・MCP を作成または変更します。"
          }
        }
      }
    },
    "agent.seed.pentest.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Penetration Test"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペネトレーションテスト"
          }
        }
      }
    },
    "agent.seed.pentest.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Standalone pentest agent: single-handedly runs the full chain from recon → attack-surface discovery → deep exploitation → verification → wrap-up, planning, executing, and adversarially verifying on its own."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "独立型ペネトレーションエージェント: 単独で偵察→攻撃面の探索→深掘りした悪用→検証→仕上げまでの全工程を実行し、自ら計画し、自ら実行し、自ら対立的に検証します。"
          }
        }
      }
    },
    "agent.seed.retester.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vulnerability Retest"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "脆弱性の再検証"
          }
        }
      }
    },
    "agent.seed.retester.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Launched manually from a finding's detail view; reads the original evidence and saves an independent retest conclusion."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "脆弱性の詳細から手動で開始し、元の証拠を読み取って、独立した再検証の結論を保存します。"
          }
        }
      }

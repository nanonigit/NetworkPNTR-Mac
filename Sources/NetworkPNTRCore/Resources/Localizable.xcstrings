    "llm.ui.rotationHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses the active configuration first, then switches by priority when a connection fails."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効な設定を最初に使い、接続障害時は優先順位に従って別の設定へ切り替えます。"

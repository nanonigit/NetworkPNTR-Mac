{
  "sourceLanguage": "en",
  "strings": {
      "native.session.preparing": {
        "localizations": {
          "en": {
            "stringUnit": {
              "state": "translated",
              "value": "Connecting to your environment"
            }
          },
          "ja": {
            "stringUnit": {
              "state": "translated",
              "value": "環境に接続しています"
            }
          }
        }
      },
      "native.session.unavailable": {
        "localizations": {
          "en": {
            "stringUnit": {
              "state": "translated",
              "value": "Could not connect to the environment"
            }
          },
          "ja": {
            "stringUnit": {
              "state": "translated",
              "value": "環境に接続できませんでした"
            }
          }
        }
      },
      "native.session.unavailableDetail": {
        "localizations": {
          "en": {
            "stringUnit": {
              "state": "translated",
              "value": "Try again or check the runtime."
            }
          },
          "ja": {
            "stringUnit": {
              "state": "translated",
              "value": "もう一度試すか、実行環境を確認してください。"
            }
          }
        }
      },
      "native.session.stopped": {
        "localizations": {
          "en": {
            "stringUnit": {
              "state": "translated",
              "value": "Environment is stopped"
            }
          },
          "ja": {
            "stringUnit": {
              "state": "translated",
              "value": "環境は停止しています"
            }
          }
        }
      },
      "native.session.retry": {
        "localizations": {
          "en": {
            "stringUnit": {
              "state": "translated",
              "value": "Reconnect"
            }
          },
          "ja": {
            "stringUnit": {
              "state": "translated",
              "value": "再接続"
            }
          }
        }
      },
      "native.session.start": {
        "localizations": {
          "en": {
            "stringUnit": {
              "state": "translated",
              "value": "Start environment"
            }
          },
          "ja": {
            "stringUnit": {
              "state": "translated",
              "value": "環境を起動"
            }
          }
        }
      },
      "mcp.clients.title": {
        "localizations": {
          "en": {
            "stringUnit": {
              "state": "translated",
              "value": "AI connections"
            }
          },
          "ja": {
            "stringUnit": {
              "state": "translated",
              "value": "AI接続"
            }
          }
        }
      },
      "mcp.clients.description": {
        "localizations": {
          "en": {
            "stringUnit": {
              "state": "translated",
              "value": "Allow AI clients on this Mac to read NetworkPNTR data."
            }
          },
          "ja": {
            "stringUnit": {
              "state": "translated",
              "value": "このMacのAIクライアントにNetworkPNTRのデータ参照を許可します。"
            }
          }
        }
      },
      "mcp.clients.readOnly": {
        "localizations": {
          "en": {
            "stringUnit": {
              "state": "translated",
              "value": "Read-only access. This connection cannot start tasks or invoke a NetworkPNTR model."
            }
          },
          "ja": {
            "stringUnit": {
              "state": "translated",
              "value": "読み取り専用です。この接続ではタスクの開始やNetworkPNTR側のモデル呼び出しは行いません。"
            }
          }
        }
      },
      "mcp.clients.clientName": {
        "localizations": {
          "en": {
            "stringUnit": {
              "state": "translated",
              "value": "Client name"
            }
          },
          "ja": {
            "stringUnit": {
              "state": "translated",
              "value": "接続先の名前"
            }
          }
        }
      },
      "mcp.clients.placeholder": {
        "localizations": {
          "en": {
            "stringUnit": {
              "state": "translated",
              "value": "Desktop AI"
            }
          },
          "ja": {
            "stringUnit": {
              "state": "translated",
              "value": "デスクトップAI"
            }
          }
        }
      },
      "mcp.clients.agentPermission": {
        "localizations": {
          "en": {
            "stringUnit": {
              "state": "translated",
              "value": "Agent names and availability"
            }
          },
          "ja": {
            "stringUnit": {
              "state": "translated",
              "value": "エージェント名と利用可否"
            }
          }
        }
      },
      "mcp.clients.taskPermission": {
        "localizations": {
          "en": {
            "stringUnit": {
              "state": "translated",
              "value": "Task status and token counts"
            }
          },
          "ja": {
            "stringUnit": {
              "state": "translated",
              "value": "タスクの状態とトークン数"
            }
          }
        }
      },
      "mcp.clients.noTasks": {
        "localizations": {
          "en": {
            "stringUnit": {
              "state": "translated",
              "value": "No tasks available to allow."
            }
          },
          "ja": {
            "stringUnit": {
              "state": "translated",
              "value": "許可できるタスクがありません。"
            }
          }
        }
      },
      "mcp.clients.tasksLoading": {
        "localizations": {
          "en": {
            "stringUnit": {
              "state": "translated",
              "value": "Loading tasks…"
            }
          },
          "ja": {
            "stringUnit": {
              "state": "translated",
              "value": "タスクを読み込み中…"
            }
          }
        }
      },
      "mcp.clients.reload": {
        "localizations": {
          "en": {
            "stringUnit": {
              "state": "translated",
              "value": "Reload tasks"
            }
          },
          "ja": {
            "stringUnit": {
              "state": "translated",
              "value": "タスクを再読み込み"
            }
          }
        }
      },
      "mcp.clients.allow": {
        "localizations": {
          "en": {
            "stringUnit": {
              "state": "translated",
              "value": "Allow connection"
            }
          },
          "ja": {
            "stringUnit": {
              "state": "translated",
              "value": "接続を許可"
            }
          }
        }
      },
      "mcp.clients.consentTitle": {
        "localizations": {
          "en": {
            "stringUnit": {
              "state": "translated",
              "value": "Allow this AI client?"
            }
          },
          "ja": {
            "stringUnit": {
              "state": "translated",
              "value": "このAIからの接続を許可しますか？"
            }
          }
        }
      },
      "mcp.clients.consentBody": {
        "localizations": {
          "en": {
            "stringUnit": {
              "state": "translated",
              "value": "Only the permissions listed below will be granted."
            }
          },
          "ja": {
            "stringUnit": {
              "state": "translated",
              "value": "以下の参照権限だけを許可します。"
            }
          }
        }
      },
      "mcp.clients.activeTitle": {
        "localizations": {
          "en": {
            "stringUnit": {
              "state": "translated",
              "value": "Allowed clients"
            }
          },
          "ja": {
            "stringUnit": {
              "state": "translated",
              "value": "許可した接続先"
            }
          }
        }
      },
      "mcp.clients.noClients": {
        "localizations": {
          "en": {
            "stringUnit": {
              "state": "translated",
              "value": "No AI clients allowed yet."
            }
          },
          "ja": {
            "stringUnit": {
              "state": "translated",
              "value": "許可したAIクライアントはありません。"
            }
          }
        }
      },
      "mcp.clients.copy": {
        "localizations": {
          "en": {
            "stringUnit": {
              "state": "translated",
              "value": "Copy MCP JSON"
            }
          },
          "ja": {
            "stringUnit": {
              "state": "translated",
              "value": "MCP設定JSONをコピー"
            }
          }
        }
      },
      "mcp.clients.copied": {
        "localizations": {
          "en": {
            "stringUnit": {
              "state": "translated",
              "value": "Configuration copied."
            }
          },
          "ja": {
            "stringUnit": {
              "state": "translated",
              "value": "設定をコピーしました。"
            }
          }
        }
      },
      "mcp.clients.revoke": {
        "localizations": {
          "en": {
            "stringUnit": {
              "state": "translated",
              "value": "Revoke access"
            }
          },
          "ja": {
            "stringUnit": {
              "state": "translated",
              "value": "接続許可を取り消す"
            }
          }
        }
      },
      "mcp.clients.cancel": {
        "localizations": {
          "en": {
            "stringUnit": {
              "state": "translated",
              "value": "Cancel"
            }
          },
          "ja": {
            "stringUnit": {
              "state": "translated",
              "value": "キャンセル"
            }
          }
        }
      },
      "mcp.clients.loginRequired": {
        "localizations": {
          "en": {
            "stringUnit": {
              "state": "translated",
              "value": "Start the local environment to allow AI connections."
            }
          },
          "ja": {
            "stringUnit": {
              "state": "translated",
              "value": "AI接続を許可するには、このMacの環境を起動してください。"
            }
          }
        }
      },
      "mcp.clients.helperUnavailable": {
        "localizations": {
          "en": {
            "stringUnit": {
              "state": "translated",
              "value": "The connection helper is unavailable. Reinstall NetworkPNTR Mac to enable connections."
            }
          },
          "ja": {
            "stringUnit": {
              "state": "translated",
              "value": "接続ヘルパーが見つかりません。NetworkPNTR Macを再インストールしてください。"
            }
          }
        }
      },
      "mcp.clients.instructions": {
        "localizations": {
          "en": {
            "stringUnit": {
              "state": "translated",
              "value": "For clients that accept MCP JSON, paste the copied configuration into their MCP settings. Keep NetworkPNTR Mac running. Stopping or restarting the environment ends access."
            }
          },
          "ja": {
            "stringUnit": {
              "state": "translated",
              "value": "MCP設定JSONに対応したクライアントの設定へ貼り付けてください。NetworkPNTR Macは起動したままにします。環境の停止・再起動で接続許可は失効します。"
            }
          }
        }
      },
      "mcp.clients.nameError": {
        "localizations": {
          "en": {
            "stringUnit": {
              "state": "translated",
              "value": "Enter a client name of 1–80 characters on one line."
            }
          },
          "ja": {
            "stringUnit": {
              "state": "translated",
              "value": "接続先の名前を1行・1〜80文字で入力してください。"
            }
          }
        }
      },
      "mcp.clients.taskError": {
        "localizations": {
          "en": {
            "stringUnit": {
              "state": "translated",
              "value": "The task selection is invalid. Reload tasks and select again."
            }
          },
          "ja": {
            "stringUnit": {
              "state": "translated",
              "value": "タスクの選択が無効です。再読み込みして選び直してください。"
            }
          }
        }
      },
      "mcp.clients.permissionError": {
        "localizations": {
          "en": {
            "stringUnit": {
              "state": "translated",
              "value": "Select at least one permission or task."
            }
          },
          "ja": {
            "stringUnit": {
              "state": "translated",
              "value": "参照項目またはタスクを1つ以上選んでください。"
            }
          }
        }
      },
      "mcp.clients.busyError": {
        "localizations": {
          "en": {
            "stringUnit": {
              "state": "translated",
              "value": "Wait until the previous connection has stopped."
            }
          },
          "ja": {
            "stringUnit": {
              "state": "translated",
              "value": "前の接続が終了するまでお待ちください。"
            }
          }
        }
      },
      "mcp.clients.capacityError": {
        "localizations": {
          "en": {
            "stringUnit": {
              "state": "translated",
              "value": "Up to 16 clients can be allowed. Revoke an existing connection first."
            }
          },
          "ja": {
            "stringUnit": {
              "state": "translated",
              "value": "許可できる接続先は16件までです。既存の接続許可を取り消してください。"
            }
          }
        }
      },
      "mcp.clients.connectionError": {
        "localizations": {
          "en": {
            "stringUnit": {
              "state": "translated",
              "value": "The connection could not be allowed. Check that NetworkPNTR is running and signed in."
            }
          },
          "ja": {
            "stringUnit": {
              "state": "translated",
              "value": "接続を許可できませんでした。NetworkPNTRの起動とログイン状態を確認してください。"
            }
          }
        }
      },
      "mcp.clients.taskLoadError": {
        "localizations": {
          "en": {
            "stringUnit": {
              "state": "translated",
              "value": "Tasks could not be loaded. Try reloading."
            }
          },
          "ja": {
            "stringUnit": {
              "state": "translated",
              "value": "タスクを取得できませんでした。再読み込みしてください。"
            }
          }
        }
      },
      "mcp.clients.selectedTasks": {
        "localizations": {
          "en": {
            "stringUnit": {
              "state": "translated",
              "value": "Selected tasks"
            }
          },
          "ja": {
            "stringUnit": {
              "state": "translated",
              "value": "選択したタスク"
            }
          }
        }
      },
